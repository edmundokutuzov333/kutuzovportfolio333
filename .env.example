# Runtime environment variables. Use the deployment provider's secret manager for secrets.
PUBLIC_SITE_URL=
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server-only key. Used for protected database operations, rate limiting and signing Admin sessions.
# Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Preferred transactional email provider: Hostinger Email SMTP.
# In Supabase Dashboard > Edge Functions > Secrets, set the secret values for production.
SMTP_HOSTNAME=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=contact@edmundokutuzov.art
SMTP_PASSWORD=
SMTP_FROM=Kutuzov Portfolio <contact@edmundokutuzov.art>
ADMIN_EMAIL=contact@edmundokutuzov.art

# Temporary fallback only while SMTP secrets are not configured.
# Remove these after confirming Hostinger SMTP delivery end-to-end.
RESEND_API_KEY=
MAIL_FROM=

# Public browser configuration. The publishable/anon key is intentionally public and protected by RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_SITE_URL=

# Backblaze B2 - videos only. Keep all values in Vercel's server-side secret
# store; never expose the key ID or application key through VITE_* variables.
BACKBLAZE_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
BACKBLAZE_S3_BUCKET=prively-media-originals-2026
BACKBLAZE_S3_REGION=eu-central-003
BACKBLAZE_S3_KEY_ID=
BACKBLAZE_S3_APPLICATION_KEY=

# GitHub-backed portfolio editor. This token is server-only and must be scoped
# to contents read/write for this repository. It is never sent to the browser.
GITHUB_PORTFOLIO_OWNER=edmundokutuzov333
GITHUB_PORTFOLIO_REPO=kutuzovportfolio333
GITHUB_PORTFOLIO_BRANCH=main
GITHUB_PORTFOLIO_TOKEN=

# JARVIS (server-only secrets)
GEMINI_API_KEY=
KB_ENABLED=false
KB_EMBED_ENABLED=false
JARVIS_DAILY_REQUEST_LIMIT=300
JARVIS_LIVE_ENABLED=false
AI_MODEL_PRIMARY=gemini-3.5-flash-lite
AI_MODEL_FALLBACK=gemini-3.5-flash

# Required for the protected nightly knowledge reindex (Vercel Cron, 02:00 UTC).
# Generate a long unpredictable token in the Vercel secret manager; never commit its value.
CRON_SECRET=

# Anonymised JARVIS query logs: retention is clamped to 30–90 days.
JARVIS_LOG_RETENTION_DAYS=60

# Optional offline-only batch embedding job; keep online retrieval fast.
KB_EMBED_BACKFILL_ENABLED=false
