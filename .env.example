# Runtime environment variables. Use the deployment provider's secret manager for secrets.
PUBLIC_SITE_URL=
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server-only key. Used for protected database operations, rate limiting and signing Admin sessions.
# Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Admin login accepts only the code entered by the administrator.
# Set the chosen three-digit code in this server-side secret, never in browser variables.
# Optional until mail workflows are enabled.
RESEND_API_KEY=
MAIL_FROM=

# Public browser configuration. The publishable/anon key is intentionally public and protected by RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_SITE_URL=
