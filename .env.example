# Runtime environment variables. Use the deployment provider's secret manager for secrets.
PUBLIC_SITE_URL=
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server-only key. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Set the required three-digit access code in the server secret manager only.
ADMIN_ACCESS_CODE=
ADMIN_EMAIL=owner@example.invalid
# At least 32 random characters. Store the value in the server secret manager.
ADMIN_RATE_LIMIT_SALT=
# Optional until mail workflows are enabled.
RESEND_API_KEY=
MAIL_FROM=

# Public browser configuration. The publishable/anon key is intentionally public and protected by RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_SITE_URL=
