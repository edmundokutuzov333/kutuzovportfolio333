# Runtime environment variables. Use the deployment provider's secret manager for secrets.
PUBLIC_SITE_URL=
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server-only key. Used for protected database operations, rate limiting and signing Admin sessions.
# Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Preferred transactional email provider: Hostinger Email SMTP.
# In Supabase Dashboard > Edge Functions > Secrets, set the secret values for production.
SMTP_HOSTNAME=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=contact@edmundokutuzov.art
SMTP_PASSWORD=
SMTP_FROM=Kutuzov Portfolio <contact@edmundokutuzov.art>
ADMIN_EMAIL=contact@edmundokutuzov.art

# Temporary fallback only while SMTP secrets are not configured.
# Remove these after confirming Hostinger SMTP delivery end-to-end.
RESEND_API_KEY=
MAIL_FROM=

# Public browser configuration. The publishable/anon key is intentionally public and protected by RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_SITE_URL=
