{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/jarvis/sync",
      "schedule": "0 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/cv/Edmundo-Kutuzov-CV-EN.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Edmundo-Kutuzov-CV-EN.pdf\""
        }
      ]
    },
    {
      "source": "/cv/Edmundo-Kutuzov-CV-PT.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Edmundo-Kutuzov-CV-PT.pdf\""
        }
      ]
    }
  ]
}
